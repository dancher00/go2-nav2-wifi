Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: go2_da3_scene
    Frame Rate: 15
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: DA3 reconstructed scene - relative scale
      Enabled: true
      Topic:
        Value: /go2_da3/reconstruction
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Color Transformer: RGB8
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 3
      Decay Time: 0
    - Class: rviz_default_plugins/Marker
      Name: DA3 estimated camera path
      Enabled: true
      Topic:
        Value: /go2_da3/reconstruction_path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5
      Focal Point:
        X: 0.8
        Y: 0
        Z: 0
      Pitch: 0.5
      Yaw: 2.5
Window Geometry:
  Width: 1100
  Height: 800
