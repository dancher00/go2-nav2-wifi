Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 32; 35; 40
    Fixed Frame: lidar3d_map
    Frame Rate: 10
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Metric grid
      Enabled: true
      Reference Frame: lidar3d_map
    - Class: rviz_default_plugins/PointCloud2
      Name: Point-LIO geometry with camera color
      Enabled: true
      Topic:
        Value: /camera_fusion/colored_map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Color Transformer: RGB8
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 3
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: DA3 supported surfaces - experimental
      Enabled: false
      Topic:
        Value: /camera_fusion/da3_supported
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Color Transformer: RGB8
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 2
    - Class: rviz_default_plugins/Marker
      Name: Calibration status
      Enabled: true
      Topic:
        Value: /camera_fusion/status_text
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Image
      Name: LiDAR projection on camera
      Enabled: true
      Topic:
        Value: /camera_fusion/projection_overlay
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5
      Pitch: 0.65
      Yaw: 0.8
      Focal Point:
        X: 1
        Y: 0
        Z: 0.5
Window Geometry:
  Width: 1200
  Height: 850
