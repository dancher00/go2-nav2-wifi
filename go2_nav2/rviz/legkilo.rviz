Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 38; 42
    Fixed Frame: lidar3d_map
    Frame Rate: 5
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Color: 90; 90; 90
    - Class: rviz_default_plugins/PointCloud2
      Name: Optimized 3D map
      Enabled: true
      Topic:
        Value: /lidar3d/registered
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Position Transformer: XYZ
      Axis: Z
      Use Fixed Frame: true
      Autocompute Value Bounds: true
      Decay Time: 0
    - Class: rviz_default_plugins/Path
      Name: LIO trajectory
      Enabled: true
      Topic:
        Value: /lidar3d/path
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Color: 255; 180; 50
      Line Style: Billboards
      Line Width: 0.03
    - Class: rviz_default_plugins/RobotModel
      Name: Go2
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/Axes
      Name: Robot body axes
      Enabled: true
      Reference Frame: base_link
      Length: 0.4
      Radius: 0.015
    - Class: rviz_default_plugins/Odometry
      Name: LiDAR IMU axes (not robot body)
      Enabled: false
      Topic:
        Value: /lidar3d/odom
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Keep: 1
      Shape: Axes
      Axes Length: 0.5
      Axes Radius: 0.03
      Position Tolerance: 0
      Angle Tolerance: 0
      Covariance:
        Position:
          Value: false
        Orientation:
          Value: false
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6
      Pitch: 0.55
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Target Frame: lidar3d_map
Window Geometry:
  Width: 1200
  Height: 850
