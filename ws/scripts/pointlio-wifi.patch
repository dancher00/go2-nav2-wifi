+
+// A single rigid output-frame choice. Never modifies filter states, the ikdtree,
+// input measurements, or subsequent scan matching. No continuous floor correction.
+void initialize_output_frame(const PointCloudXYZI::Ptr &initial_cloud)
+{
+    bool applied = false;
+    size_t support = 0;
+    Eigen::Vector3d normal = Eigen::Vector3d::Zero();
+    double distance = 0.0;
+    if (align_output_to_floor)
+    {
+        PointCloudXYZI::Ptr nearby(new PointCloudXYZI());
+        for (const auto &point : initial_cloud->points)
+            if (point.getVector3fMap().norm() < 4.0f)
+                nearby->push_back(point);
+        pcl::SACSegmentation<PointType> segment;
+        segment.setOptimizeCoefficients(true);
+        segment.setModelType(pcl::SACMODEL_PERPENDICULAR_PLANE);
+        segment.setMethodType(pcl::SAC_RANSAC);
+        segment.setAxis(Eigen::Vector3f::UnitZ());
+        segment.setEpsAngle(0.7853981633974483);
+        segment.setDistanceThreshold(0.025);
+        segment.setMaxIterations(300);
+        segment.setInputCloud(nearby);
+        pcl::PointIndices inliers;
+        pcl::ModelCoefficients plane;
+        segment.segment(inliers, plane);
+        support = inliers.indices.size();
+        if (support >= 50 && plane.values.size() == 4)
+        {
+            normal = Eigen::Vector3d(plane.values[0], plane.values[1], plane.values[2]);
+            distance = plane.values[3] / normal.norm();
+            normal.normalize();
+            if (normal.z() < 0.0) { normal = -normal; distance = -distance; }
+            // Go2 L1 points toward the ground. Reject a plane above the sensor.
+            if (distance < -0.02 && distance > -1.5)
+            {
+                Eigen::Vector3d up = -normal;
+                Eigen::Vector3d x = Eigen::Vector3d::UnitX() - up.x() * up;
+                x.normalize();
+                output_rotation.row(0) = x.transpose();
+                output_rotation.row(1) = up.cross(x).transpose();
+                output_rotation.row(2) = up.transpose();
+                output_translation.z() = -distance; // Initial plane is z=0.
+                applied = true;
+            }
+        }
+    }
+    std::ofstream report(root_dir + "output-frame.json");
+    report << std::setprecision(17) << "{\"frame\":\"" << output_frame
+           << "\",\"floor_alignment_requested\":" << (align_output_to_floor ? "true" : "false")
+           << ",\"floor_alignment_applied\":" << (applied ? "true" : "false")
+           << ",\"plane_inliers\":" << support << ",\"initial_points\":" << initial_cloud->size()
+           << ",\"plane_distance\":" << distance << ",\"rotation_row_major\":[";
+    for (int row = 0; row < 3; ++row)
+        for (int col = 0; col < 3; ++col)
+            report << (row || col ? "," : "") << output_rotation(row, col);
+    report << "],\"translation\":[" << output_translation.x() << "," << output_translation.y()
+           << "," << output_translation.z() << "]}\n";
+    std::cout << "Output frame " << output_frame << ": initial floor alignment "
+              << (applied ? "applied" : "not applied") << ", inliers=" << support << std::endl;
+}
+
+void transform_output_cloud(PointCloudXYZI &cloud)
+{
+    Eigen::Matrix4f transform = Eigen::Matrix4f::Identity();
+    transform.block<3,3>(0,0) = output_rotation.cast<float>();
+    transform.block<3,1>(0,3) = output_translation.cast<float>();
+    pcl::transformPointCloud(cloud, cloud, transform);
+}
 
