+std::shared_ptr<const Backend::Visualization> Backend::visualization() {
+    std::lock_guard<std::mutex> lock(visualization_mutex_);
+    return visualization_;
+}
+
+void Backend::updateVisualization(bool force) {
+    // All submap and pose access occurs in the existing backend worker.
+    // ROS reads only an immutable snapshot, never mutable submap clouds.
+    if (visualization_poses_.empty()) return;
+    const double stamp = visualization_poses_.back().timestamp;
+    auto previous = visualization();
+    if (!force && previous && stamp - previous->timestamp < 1.0) return;
+    auto output = std::make_shared<Visualization>();
+    output->timestamp = stamp;
+    output->revision = previous ? previous->revision + 1 : 1;
+    std::map<NodeType, Eigen::Isometry3d> corrections;
+    for (const auto& [id, submap] : finished_submaps_) {
+        corrections[id] = submap->getOriginOpti() * submap->getOrigin().inverse();
+    }
+    if (!corrections.empty()) output->correction = corrections.rbegin()->second;
+    if (visualization_map_dirty_ || !previous) {
+        output->cloud = pcl_utils::makeCloud<PointType>();
+        for (const auto& [id, submap] : finished_submaps_) {
+            auto cloud = submap->getCloud();
+            if (cloud) {
+                PointCloudType transformed;
+                pcl::transformPointCloud(*cloud, transformed, submap->getOriginOpti().matrix().cast<float>());
+                *output->cloud += transformed;
+            }
+            submap->releaseCloud();
+        }
+        if (current_submap_ && current_submap_->getNumFrames()) {
+            CloudPtr reduced = pcl_utils::makeCloud<PointType>();
+            VoxelGrid filter(0.1, SamplingMode::MedianRepresentative);
+            filter.filter(current_submap_->getCloud(), reduced);
+            PointCloudType transformed;
+            const Eigen::Isometry3d pose = output->correction * current_submap_->getOrigin();
+            pcl::transformPointCloud(*reduced, transformed, pose.matrix().cast<float>());
+            *output->cloud += transformed;
+        }
+        visualization_map_dirty_ = false;
+    } else {
+        output->cloud = previous->cloud;
+    }
+    output->trajectory.reserve(visualization_poses_.size());
+    for (const auto& frame : visualization_poses_) {
+        auto found = corrections.find(frame.submap_id);
+        const Eigen::Isometry3d correction = found == corrections.end() ? output->correction : found->second;
+        output->trajectory.emplace_back(frame.timestamp, correction * frame.pose);
+    }
+    std::lock_guard<std::mutex> lock(visualization_mutex_);
+    visualization_ = output;
 }
 
 void Backend::updateRecordedSubmaps() {
