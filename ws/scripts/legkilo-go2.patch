+void RosInterface::publishBackendVisualization() {
+    auto snapshot = backend_->visualization();
+    if (!snapshot || snapshot->revision <= last_visualization_revision_) return;
+    this->publishPointcloudWorld(snapshot->timestamp, snapshot->cloud);
+    path_world_.poses.clear();
+    path_world_.poses.reserve(snapshot->trajectory.size());
+    for (const auto& [stamp, pose] : snapshot->trajectory) {
+        ros_compat::PoseStampedMsg msg;
+        msg.header.stamp = ros_compat::fromSec(stamp);
+        msg.header.frame_id = "lidar3d_map";
+        msg.pose.position.x = pose.translation().x();
+        msg.pose.position.y = pose.translation().y();
+        msg.pose.position.z = pose.translation().z();
+        const Eigen::Quaterniond q(pose.rotation());
+        msg.pose.orientation.x = q.x(); msg.pose.orientation.y = q.y();
+        msg.pose.orientation.z = q.z(); msg.pose.orientation.w = q.w();
+        path_world_.poses.push_back(msg);
+    }
+    path_world_.header.stamp = ros_compat::fromSec(snapshot->timestamp);
+    path_world_.header.frame_id = "lidar3d_map";
+    pub_path_->publish(path_world_);
+    last_visualization_revision_ = snapshot->revision;
+}
