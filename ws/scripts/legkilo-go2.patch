+// Optional input audit, inside the existing estimator thread. No ROS observer.
+// Hash named fields only: PCL/struct padding is not measurement data.
+uint64_t auditBytes(uint64_t hash, const void* data, size_t size) {
+    const auto* bytes = static_cast<const unsigned char*>(data);
+    for (size_t i = 0; i < size; ++i) { hash ^= bytes[i]; hash *= 1099511628211ULL; }
+    return hash;
+}
+uint64_t auditCloud(const CloudPtr& cloud) {
+    uint64_t hash = 14695981039346656037ULL;
+    for (const auto& p : cloud->points) {
+        const float fields[] = {p.x, p.y, p.z, p.intensity, p.curvature};
+        hash = auditBytes(hash, fields, sizeof(fields));
+    }
+    return hash;
+}
+void auditInput(const common::MeasGroup& measure, const CloudPtr& down) {
+    static const char* path = std::getenv("GO2_LEGKILO_INPUT_TRACE");
+    if (!path || !*path) return;
+    static std::ofstream out(path);
+    static uint64_t frame = 0;
+    out << std::setprecision(17);
+    out << "frame," << frame << "," << measure.lidar_scan_.lidar_begin_time_ << ","
+        << measure.lidar_scan_.lidar_end_time_ << "," << measure.lidar_scan_.cloud_->size() << ","
+        << auditCloud(measure.lidar_scan_.cloud_) << "," << down->size() << "," << auditCloud(down)
+        << "," << measure.kin_imus_.size() << "\n";
+    for (const auto& k : measure.kin_imus_) {
+        auto imu = auditBytes(14695981039346656037ULL, k.acc_, sizeof(k.acc_));
+        imu = auditBytes(imu, k.gyr_, sizeof(k.gyr_));
+        auto feet = auditBytes(14695981039346656037ULL, k.foot_pos_, sizeof(k.foot_pos_));
+        feet = auditBytes(feet, k.foot_vel_, sizeof(k.foot_vel_));
+        unsigned contacts = 0;
+        for (unsigned i = 0; i < 4; ++i) contacts |= unsigned(k.contact_[i]) << i;
+        out << "kin," << frame << "," << k.time_stamp_ << "," << imu << "," << feet << "," << contacts << "\n";
+    }
+    ++frame;
+}
